<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050912">

    <!-- Android Top Status Bar Simulator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#1B1B1B"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12:00"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📶 5G  🔋 100%"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#050912">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- App Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/ivLogo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center"
                    android:text="👑"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_title"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_subtitle"
                        android:textColor="#38BDF8"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:background="#092433"
                    android:text="MENU"
                    android:textColor="#9DE7FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConnected"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="#09251A"
                    android:text="Connected"
                    android:textColor="#85EFAC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSet"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="#0C2D48"
                    android:text="SET"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 1: Banner & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_banner"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version_tag"
                    android:textColor="#FDE047"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/banner_headline"
                    android:textColor="#BAE6FD"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="#091013"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="SYNC LOCKED"
                        android:textColor="#556B70"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLiveBoard"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="#0C2D48"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🎮 LIVE"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnKey"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="#171F2C"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="KEY"
                        android:textColor="#FBBF24"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1E2C45" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STATE" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MENU" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TURN" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvTurn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvLast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#F9D36B" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCK" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvLock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTO" android:textColor="#8BD3FF" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Target Player & Teams -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET PLAYER:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- 4 Colors Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnColorBlue"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="#2464E8"
                        android:text="🔵"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnColorRed"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="24dp"
                        android:background="#DD2724"
                        android:text="🔴"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnColorGreen"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="24dp"
                        android:background="#17A34A"
                        android:text="🟢"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnColorYellow"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="24dp"
                        android:background="#C98B04"
                        android:text="🟡"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 2v2 Teams Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnTeamBlueGreen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#091D30"
                        android:padding="10dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️ TEAM BLUE &amp; GREEN" android:textColor="#38BDF8" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔵 Blue • 🟢 Green" android:textColor="#FFFFFF" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teammates (Seats 0 &amp; 2)" android:textColor="#7DD3FC" android:textSize="9sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnTeamRedYellow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="#2A1215"
                        android:padding="10dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚔️ TEAM RED &amp; YELLOW" android:textColor="#FB7185" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔴 Red • 🟡 Yellow" android:textColor="#FFFFFF" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teammates (Seats 1 &amp; 3)" android:textColor="#FCA5A5" android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Smart Tactics & RNG Profiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART MODE &amp; TACTICS:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Profile Buttons Row -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btnProfCursed" android:layout_width="wrap_content" android:layout_height="36dp" android:background="#0A1220" android:text="💀 Cursed 0%" android:textColor="#94A3B8" android:textSize="9sp"/>
                        <Button android:id="@+id/btnProfMild" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="#0A1220" android:text="🌤️ Mild 25%" android:textColor="#94A3B8" android:textSize="9sp"/>
                        <Button android:id="@+id/btnProfRobots" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="#0E2A4A" android:text="🤖 Robots 50%" android:textColor="#38BDF8" android:textSize="9sp" android:textStyle="bold"/>
                        <Button android:id="@+id/btnProfLucky" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="#0A1220" android:text="🎯 Lucky 75%" android:textColor="#94A3B8" android:textSize="9sp"/>
                        <Button android:id="@+id/btnProfGod" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="#0A1220" android:text="⚡ God Mode 100%" android:textColor="#94A3B8" android:textSize="9sp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Active Profile Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_dark"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/tvProfileName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🤖 ROBOTS" android:textColor="#BAE6FD" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvProfilePct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50%" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Standard fair simulation • Neutral 50% machine RNG"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="● Controller v5.0 • Neural Tactical Engine Active"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Card 4: 1-Shot Dice Pad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎲 1-SHOT DICE PAD • v5.0"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAutoRng"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_pill_dark"
                        android:text="↺ AUTO RNG"
                        android:textColor="#7DD3FC"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 6 Dice Buttons (3 rows x 2 columns) -->
                <!-- Row 1: 1 and 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDice1"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dice_button"
                        android:text="1\nROLL 1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDice2"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_dice_button"
                        android:text="2\nROLL 2"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: 3 and 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDice3"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dice_button"
                        android:text="3\nROLL 3"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDice4"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_dice_button"
                        android:text="4\nROLL 4"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3: 5 and 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDice5"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dice_button"
                        android:text="5\nROLL 5"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDice6"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_dice_button"
                        android:text="6\nROLL 6"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
